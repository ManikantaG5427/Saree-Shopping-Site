# Sri Lakshmi Saree House - MERN Backend Environment Configuration
PORT=5000
NODE_ENV=production
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saree_db?retryWrites=true&w=majority

# JWT Secrets (min 32 characters)
JWT_SECRET=super_secret_jwt_key_for_sri_lakshmi_saree_house_2025
JWT_REFRESH_SECRET=super_secret_refresh_key_for_sri_lakshmi_saree_house_2025

# Origins
CORS_ORIGIN=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Razorpay Payment Gateway (Optional / Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Dispatch (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=concierge@srilakshmisarees.com
SMTP_PASS=your_app_password
EMAIL_FROM="Sri Lakshmi Saree House <concierge@srilakshmisarees.com>"
