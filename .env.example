# Database
# Option 1: Local PostgreSQL (install from https://www.postgresql.org/download/windows/)
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/saree_web?schema=public"

# Option 2: Neon (free serverless PostgreSQL) - create at https://neon.tech
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/saree_web?sslmode=require"

# Option 3: Supabase (free PostgreSQL) - create at https://supabase.com
# DATABASE_URL="postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=require"

# For now, using placeholder - REPLACE WITH YOUR DATABASE URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saree_web?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT - CHANGE THESE IN PRODUCTION!
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production-min-32-chars"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary (get from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@sareeweb.com"